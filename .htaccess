# Hostinger (LiteSpeed / Apache): copied into dist/ by Vite and uploaded with the site.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Hostinger's Git deployment keeps a .git folder in public_html: never serve it
	# (or any other dot-folder such as .github).
	RewriteRule (^|/)\.(git|github)(/|$) - [F,L]

	# One address for the site: https and no www.
	RewriteCond %{HTTPS} off [OR]
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

	# Single-page app: any path that is not a real file or folder is served index.html,
	# so /web-development/, /about/ and the other pages open directly and on refresh.
	RewriteRule ^index\.html$ - [L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule . /index.html [L]
</IfModule>

# Hashed build files never change; let browsers keep them.
<IfModule mod_headers.c>
	<FilesMatch "\.(js|css|webp|jpg|jpeg|png|svg|mp4|woff2?)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
</IfModule>
